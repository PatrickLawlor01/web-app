    <% if (conj.activeParticiple() || conj.passiveParticiple()) {
    %>
    <table>
        <thead>
            <tr>
                <th>Nominals</th><th></th>
            </tr>
        </thead>
        <tbody>
            <% if (conj.activeParticiple()) {
            %>
            <tr>
                <td>Active Participle</td><td><%= conj.activeParticiple() %></td>
            </tr>
            <%
            } %>
            <% if (conj.passiveParticiple()) {
            %>
            <tr>
                <td>Passive Participle</td><td><%= conj.passiveParticiple() %></td>
            </tr>
            <%
            } %>
        </tbody>
    </table>
    <%
    } %>

    <br/><br/>

