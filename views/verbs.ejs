<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>plawlor01</title>
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body>

    <table>
        <thead>
            <tr>
                <th>Basic past tense</th><th>Basic present tense</th><th>Imperative</th><th>Translation</th>
            </tr>
        </thead>
        <tbody>

            <% data.forEach(row => { %>

                <tr>
                    <td><%= row.basic_e %></td><td><%= row.basicp_e %></td><td><%= row.basici_e%></td><td><%= row.translate %></td>
                </tr>

            <% }) %>

        </tbody>
    </table>


</body>
</html>